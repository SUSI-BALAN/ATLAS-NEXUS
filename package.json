{
  "name": "atlas-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first repository cloning and source research desktop application",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @atlas-nexus/desktop",
    "start": "npm run start --workspace @atlas-nexus/desktop",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b --pretty false && npm run build --workspace @atlas-nexus/desktop && node scripts/verify-preload.mjs",
    "verify:preload": "node scripts/verify-preload.mjs",
    "diagnose:electron": "electron scripts/electron-smoke.cjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@tailwindcss/oxide@4.1.14": true
  }
}
